{
  "name": "otulea",
  "private": true,
  "scripts": {
    "start": "meteor run",
    "test:once": "meteor test --once --driver-package meteortesting:mocha",
    "test:app": "TEST_WATCH=1 meteor test --full-app --driver-package meteortesting:mocha",
    "lint:code": "npx @biomejs/biome lint ./",
    "lint:code-fix": "npx @biomejs/biome lint --write ./",
    "format:code": "npx @biomejs/biome format ./",
    "format:code-fix": "npx @biomejs/biome format --write ./",
    "build:notes-tree": "markdown-notes-tree && npm run lint:markdown-fix",
    "visualize": "meteor --production --extra-packages bundle-visualizer,dynamic-import --settings=settings.json"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@fortawesome/fontawesome-free": "^5.15.4",
    "@popperjs/core": "^2.11.8",
    "bcrypt": "^6.0.0",
    "bootstrap": "^5.3.8",
    "debug": "^4.4.3",
    "detect-os": "^1.2.1",
    "easy-speech": "^2.4.0",
    "helmet": "^8.1.0",
    "jquery": "^4.0.0",
    "marked": "^17.0.1",
    "meteor-node-stubs": "^1.2.25",
    "print-js": "^1.6.0",
    "showdown": "^2.1.0",
    "ua-parser-js": "^2.0.9"
  },
  "meteor": {
    "mainModule": {
      "client": "client/main.js",
      "server": "server/main.js"
    },
    "testModule": "tests/main.js"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@biomejs/biome": "2.5.12",
    "babel-plugin-istanbul": "^7.0.1",
    "chai": "^6.2.2",
    "puppeteer": "^24.37.2",
    "simpl-schema": "^1.13.1",
    "sinon": "^21.0.1"
  },
  "babel": {
    "env": {
      "COVERAGE": {
        "plugins": [
          "istanbul"
        ]
      }
    }
  }
}
