{
  "name": "otulea",
  "private": true,
  "scripts": {
    "start": "meteor run",
    "test:once": "meteor test --once --driver-package meteortesting:mocha",
    "test:app": "TEST_WATCH=1 meteor test --full-app --driver-package meteortesting:mocha",
    "lint:code": "standardx -v | snazzy",
    "lint:code-fix": "standardx --fix -v | snazzy",
    "lint:style": "stylelint \"**/*.scss\"",
    "lint:style-fix": "stylelint --fix \"**/*.scss\"",
    "build:notes-tree": "markdown-notes-tree && npm run lint:markdown-fix",
    "visualize": "meteor --production --extra-packages bundle-visualizer,dynamic-import --settings=settings.json"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@fortawesome/fontawesome-free": "^5.15.4",
    "@popperjs/core": "^2.11.8",
    "bcrypt": "^6.0.0",
    "bootstrap": "^5.3.8",
    "debug": "^4.4.3",
    "detect-os": "^1.2.1",
    "easy-speech": "^2.4.0",
    "helmet": "^8.1.0",
    "jquery": "^4.0.0",
    "marked": "^17.0.1",
    "meteor-node-stubs": "^1.2.25",
    "print-js": "^1.6.0",
    "showdown": "^2.1.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "ua-parser-js": "^2.0.9"
  },
  "meteor": {
    "mainModule": {
      "client": "client/main.js",
      "server": "server/main.js"
    },
    "testModule": "tests/main.js"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "babel-plugin-istanbul": "^7.0.1",
    "chai": "^6.2.2",
    "eslint-plugin-security": "^3.0.1",
    "puppeteer": "^24.37.2",
    "sinon": "^21.0.1",
    "snazzy": "^9.0.0",
    "standardx": "^7.0.0",
    "stylelint": "^17.2.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "eslintConfig": {
    "parser": "@babel/eslint-parser",
    "parserOptions": {
      "sourceType": "module",
      "allowImportExportEverywhere": true
    },
    "rules": {
      "brace-style": [
        "error",
        "stroustrup",
        {
          "allowSingleLine": true
        }
      ],
      "import/no-duplicates": 0
    }
  },
  "babel": {
    "env": {
      "COVERAGE": {
        "plugins": [
          "istanbul"
        ]
      }
    }
  }
}
